# ==============================================================================
# ORCHESTRATOR APPLICATION CONFIGURATION
# ==============================================================================

# Môi trường chạy ứng dụng (development / production)
ORCHESTRATOR_ENV=development

# Cấu hình Server gRPC & HTTP
ORCHESTRATOR_GRPC_HOST=0.0.0.0
ORCHESTRATOR_GRPC_PORT=50054

# Cấu hình kết nối Redis
ORCHESTRATOR_REDIS_URL=redis://localhost:6379
ORCHESTRATOR_REDIS_DB=0
ORCHESTRATOR_REDIS_JOB_TTL_SEC=3600

# Cấu hình kết nối và xử lý Image AI gRPC
ORCHESTRATOR_IMAGE_AI_GRPC_TARGET=localhost:50051
ORCHESTRATOR_IMAGE_AI_WIDTH=512
ORCHESTRATOR_IMAGE_AI_HEIGHT=512
ORCHESTRATOR_IMAGE_AI_STEPS=20

# Cấu hình Polling (kiểm tra trạng thái) của Image Job
ORCHESTRATOR_IMAGE_POLL_INTERVAL_SEC=2
ORCHESTRATOR_IMAGE_POLL_MAX_ATTEMPTS=120

# Cấu hình kết nối Story AI (REST/FastAPI — không phải gRPC)
# Cảnh báo: story-ai mặc định chạy port 50052 (Config.PORT trong story-ai/src/config.py)
# — TRÙNG với ORCHESTRATOR_GRPC_PORT ở trên. Nếu chạy 2 service cùng máy, đổi 1 trong 2.
ORCHESTRATOR_STORY_AI_API_URL=http://localhost:50052
ORCHESTRATOR_STORY_AI_TIMEOUT_SEC=10

# NOTE: If `image-ai` requires HF_TOKEN, set it in image-ai/.env (HF_TOKEN=hf_xxx...)